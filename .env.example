# Public UI address; no secrets belong in NEXT_PUBLIC_ variables.
APP_ORIGIN=http://127.0.0.1:3000
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3001
# Register a confidential Twitch application. Never use NEXT_PUBLIC_ for secrets.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://127.0.0.1:3000/api/auth/twitch/callback
# 32 random bytes as 64 hex characters. Required for configured Twitch in production.
# README explains initialization directly into the ignored .env without printing it.
SESSION_ENCRYPTION_KEY=
# Resolved relative to the realtime workspace process. Keep outside public/static folders.
DATA_DIRECTORY=.data
# Build-time internal rewrite destination; update alongside REALTIME_PORT, then rebuild Next.
REALTIME_INTERNAL_URL=http://127.0.0.1:3001
